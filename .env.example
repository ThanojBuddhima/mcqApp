# Application
APP_NAME=MCQ Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://mcq:mcq_secret@localhost:5432/mcq_db
DATABASE_URL_SYNC=postgresql://mcq:mcq_secret@localhost:5432/mcq_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mcq-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# AI
GEMINI_API_KEY=
OPENAI_API_KEY=

# PayHere (Sri Lanka)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# CORS (Flutter web uses random localhost ports — regex enabled in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_LOCALHOST_REGEX=true
